pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	levelx,levely = 16,0
	
	local lvldata = lvlinit(levelx,levely)
	spawn = lvldata[1]
	levers = lvldata[2]
	plates = lvldata[3]
	a = spawn.x
	
	players = {plrinit(spawn)}
	playerno = 1
	player = players[playerno]
	player.active = true
end

function _update60()
	if (btn(➡️) or btn(⬅️)) and not player.crouching then 
		if not player.running then
			player.running = true
			player.sprite = 2
		end
			
		if btn(➡️) then
			player.velx = 1
			player.fx = false
		
		else
			player.velx = -1
			player.fx = true
			
		end
		
	else
		player.running = false
	end
	
	if btn(🅾️) then  -- jump
		if player.onplat and player.crouching then
			player.onplat = false
			player.vely = player.gravity
			player.y += 8
		elseif player.onground or player.onplat then
			player.vely = -player.jump_force
			player.onground = false
			player.onplat = false
		end
	end
	if btn(⬇️) then  -- crouch
		player.crouching = true
	else
		player.crouching = false
	end
	
	-- switch players / interact
	if btn(❎) and player.cooldown == 0 then -- use/die
		if  then
			
		else
			player.active = false		
			playerno += 1
			if (playerno > count(players)) playerno = 1
			player = players[playerno]
			player.active = true
			mset(flr(player.x/8),flr(player.y/8),0)
			player.solid = false
		end
		player.cooldown = 60
	end
	
	for i in all(players) do
		if i.active then
			if player.running then
				player.first_frame = 1
				player.last_frame = 4
				player.ani_speed = 10
			else
				player.velx = 0 
				player.sprite = 1
				player.ani_speed = 0
			end
		else
			if i.vely != 0 then
				i.sprite = 6
			elseif not i.solid then
				if mget(flr(i.x/8),flr(i.y/8)) == 0 then
					mset(flr(i.x/8),flr(i.y/8),6)
					i.x,i.y = flr(i.x/8)*8,flr(i.y/8)*8
				elseif mget(flr((i.x+7)/8),flr(i.y/8)) == 0 then
					mset(flr((i.x+7)/8),flr(i.y/8),6)
					i.x,i.y = flr((i.x+7)/8)*8,flr(i.y/8)*8
				end
				i.sprite = 0
				i.solid = true
			end
			i.ani_speed = 0
			i.velx = 0
			if (i.vely < 0) i.vely = 0
		end
		
		if i.vely < 3 and not i.onground then
			i.vely += i.gravity
		end
		
		move(levelx, levely, i)
	end
	
	
	
	--pressure plate
	if mget(flr(player.x/8),flr(player.y/8)) == 15 then
		mset(flr(player.x/8),flr(player.y/8),31)
	elseif	mget(flr((player.x+7)/8),flr(player.y/8)) == 15 then
		mset(flr((player.x+7)/8),flr(player.y/8),31)
	end
	
	--death
	if fget(mget(flr(player.x/8),flr(player.y/8)),3) or
			 fget(mget(flr((player.x+7)/8),flr(player.y/8)),3) then
			 playerno = player:die(playerno, players, spawn)
			 player = players[playerno]
				player.active = true
				player.cooldown = 60
	end
	
	--status
	if player.crouching then
		player.sprite = 5
		player.ani_speed = 0
	end
	
	if player.cooldown > 0 then
		player.cooldown -= 1
	end
	
	if player.onground or player.onplat then
		player.vely = 0
		player.y = flr(player.y/8)*8
	end
	
	
end

function _draw()
	camera()
	cls()
	print(player.velx)
	print(player.vely)
	print(player.x)
	print(player.y)
	print(playerno)
	print(a)
	camera(levelx*8,levely*8)
	map()
	for i in all(players) do
		spr(i.sprite, i.x, i.y,1,1,i.fx,i.fy)
	end
	for i in all(levers) do
		if i.active then 
			spr(14,i.x,i.y)
		else 
			spr(30,i.x,i.y)
		end
	end
	for i in all(plates) do
		if i.active then 
			spr(15,i.x,i.y)
		else 
			spr(31,i.x,i.y)
		end
	end
end
-->8
-- player --

function plrinit(spawn)
	local player = {
-- position --
		x = spawn.x, 
		y = spawn.y,
-- flipping --
		fx = false,
		fy = false,
-- sprite animation --
		first_frame = 1,
		last_frame = 1,
		ani_speed = 0,
		sprite = 1,
		stimer = 1,
-- physics --
		velx = 0,
		vely = 0,
		jump_force = 3,
		gravity = 0.2,
-- status --
		active = false,
		solid = false,
		running = false,
		crouching = false,
		onground = true,
		onplat = false,
		cooldown = 0,
-- functions --
		die = function(self, playerno, players, spawn)
			self.active = false
			self.velx = 0
			self.vely = 0
			if fget(mget(flr(self.x/8),flr(self.y/8)),3) then
				mset(flr(self.x/8),flr(self.y/8),0)
			end
			if fget(mget(flr((self.x+7)/8),flr(self.y/8)),3) then
				mset(flr((self.x+7)/8),flr(self.y/8),0)
			end
			add(players, plrinit(spawn))		
			playerno = count(players)
			return playerno
			--reset level todo
		end,
	}
	return player
end
-->8
-- collision --
function tile(x, y)
	return {flr(x/8), flr(y/8)}
end

function flagof(x,y)
	return fget(mget(x/8,y/8))
end

function issolid(x,y)
	return fget(mget(x/8,y/8),0)
end

function isplat(x,y)
	return fget(mget(x/8,y/8),1)
end

function move(sx, sy, go) --game object

	go.x += go.velx
	go.y += go.vely
	
	-- flags
	local tlf = flagof(go.x, go.y)
	local trf = flagof(go.x+7, go.y)
	local blf = flagof(go.x, go.y+7)
	local brf = flagof(go.x+7, go.y+7)

	-- solids
	local tl = tlf == 1
	local tr = trf == 1
	local bl = blf == 1
	local br = brf == 1
	
	--right of block
	if (tl or bl) and not (tr or br) then
		--from above
		if (bl or br) and not (tl or tr) then
			if (flr(go.x/8)*8+7 - go.x) > (go.y+7 - flr((go.y+7)/8)*8) then
				go.y = (tile(go.x, go.y+7)[2]-1)*8
				go.onground = true
				go.vely = 0
			else
				go.x = (tile(go.x, go.y)[1]+1)*8
			end
		--from below	
		elseif (tl or tr) and not (bl or br) then
			if (flr(go.x/8)*8+7 - go.x) > (flr(go.y/8)*8+7 - go.y) then
				go.y = (tile(go.x, go.y)[2]+1)*8
				go.vely = 0
			else
				go.x = (tile(go.x, go.y)[1]+1)*8
			end
		--from side
		else
			go.x = (flr(go.x/8)+1)*8
		end
	
	--left of block
	elseif (tr or br) and not (tl or bl) then
		--from above
		if (bl or br) and not (tl or tr) then
			if (go.x+7 - flr((go.x+7)/8)*8) > (go.y+7 - flr((go.y+7)/8)*8) then			
			 go.y = (tile(go.x, go.y+7)[2]-1)*8
				go.onground = true
				go.vely = 0
			else
			 go.x = (tile(go.x+7, go.y)[1]-1)*8
			end
			
		--from below
		elseif (tl or tr) and not (bl or br) then

			if (go.x+7 - flr((go.x+7)/8)*8) > (flr(go.y/8)*8+7 - go.y) then
				go.y = (tile(go.x+7, go.y)[2]+1)*8
				go.vely = 0
			else
				go.x = (tile(go.x+7, go.y)[1]-1)*8
			end
		else
			go.x = flr(go.x/8)*8
		end
	--middle of block
	else
		--above
		if bl and br then
			go.y = flr(go.y/8)*8
			go.onground = true
			go.vely = 0
		--below
		elseif tl and tr then
			go.y = (flr(go.y/8)+1)*8
			go.vely = 0
		end
	end
	
	-- world borders
	if (go.x < sx) go.x = sx
	if (go.x + 7 > (sx+15)*8 + 7) go.x = (sx+15)*8
	if (go.y < sy) go.y = sy
	if (go.y + 7 > (sy+15)*8 + 7) go.y = (sy+15)*8
	
	-- onground or not
	if issolid(go.x,go.y+8) or issolid(go.x+7,go.y+8) then
	 go.onground = true
	else
		go.onground = false
	end
	
	if go.vely > 0 and (isplat(go.x,go.y+8) or isplat(go.x+7,go.y+8)) then
		go.onplat = true
	else
		go.onplat = false
	end
end
-->8
function lvlinit(sx, sy)
	local spawn = {x=0,y=0}
	local plates = {}
	local levers = {}
	for i=sx,sx+15 do
		for j=sy,sy+15 do
			if mget(i,j) == 46 then --spawn
				spawn.x,spawn.y=i*8,(j-1)*8
			elseif mget(i,j) == 14 then
				add(levers, {x=i*8,y=j*8,active=0})
				mset(i,j,0)
			elseif mget(i,j) == 30 then
				add(levers, {x=i*8,y=j*8,active=1}) 
				mset(i,j,0)
			elseif mget(i,j) == 15 then
				add(plates, {x=i*8,y=j*8,active=0})
				mset(i,j,0)
			end
		end
	end
	
	camera(sx*8,sy*8)
	print(0)
--	local players = {plrinit(spawn)}
	return {spawn,levers,plates}
end
