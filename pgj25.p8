pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function tile(x, y)
	return {flr(x/8), flr(y/8)}
end

function _init()
	plrinit()
end

function _update60()
	if (btn(➡️) or btn(⬅️)) and not player.crouching then 
		if not player.running then
			player.running = true
			player.sprite = 2
		end
			
		if btn(➡️) then
			player.velx = 1
			player.fx = false
		
		else
			player.velx = -1
			player.fx = true
			
		end
		
	else
		player.running = false
	end
	
	if btn(🅾️) then  -- jump
		if player.onplat and player.crouching then
			player.onplat = false
			player.vely = player.gravity
			player.y += 8
		elseif player.onground or player.onplat then
			player.vely = -player.jump_force
			player.onground = false
			player.onplat = false
		end
	end
	if btn(⬇️) then  -- crouch
		player.crouching = true
	else
		player.crouching = false
	end
	
	if player.vely < 3 and not player.onground then
		player.vely += player.gravity
	end
	
	if fget(mget(tile(player.x+8,player.y+8)[2]+1),0) then
		player.onground = true
	end
	
	move(player)
	
	if player.running then
		player.first_frame = 1
		player.last_frame = 4
		player.ani_speed = 10
	else
		player.velx = 0 
		player.sprite = 1
		player.ani_speed = 0
	end
	
	if player.crouching then
		player.sprite = 5
		player.ani_speed = 0
	end
	
	if player.onground or player.onplat then
		player.vely = 0
		player.y = flr(player.y/8)*8
	end
	
	
end

function _draw()
	cls()
	print(player.vely)
	print(player.y)
	print(player.velx)
	print(player.x)
	map()
	spr(player.sprite, player.x, player.y,1,1,player.fx,player.fy)
end
-->8
-- player --

function plrinit()
	player = {
-- position --
		x = 48, 
		y = 0,
-- flipping --
		fx = false,
		fy = false,
-- sprite animation --
		first_frame = 1,
		last_frame = 1,
		ani_speed = 0,
		sprite = 1,
		stimer = 1,
-- physics --
		velx = 0,
		vely = 0,
		jump_force = 3,
		gravity = 0.2,
-- status --
		running = false,
		crouching = false,
		onground = true,
		onplay = false,
	}
end
-->8
-- collision --
function flagof(x,y)
	return fget(mget(x/8,y/8))
end

function issolid(x,y)
	return fget(mget(x/8,y/8),0)
end

function isplat(x,y)
	return fget(mget(x/8,y/8),1)
end

function move(go) --game object

	go.x += go.velx
	go.y += go.vely
	
	-- flags
	local tlf = flagof(go.x, go.y)
	local trf = flagof(go.x+7, go.y)
	local blf = flagof(go.x, go.y+7)
	local brf = flagof(go.x+7, go.y+7)

	-- solids
	local tl = tlf == 1
	local tr = trf == 1
	local bl = blf == 1
	local br = brf == 1
	
	--right of block
	if (tl or bl) and not (tr or br) then
		--from above
		if (bl or br) and not (tl or tr) then
			if (flr(go.x/8)*8+7 - go.x) > (go.y+7 - flr((go.y+7)/8)*8) then
				go.y = (tile(go.x, go.y+7)[2]-1)*8
				go.onground = true
				go.vely = 0
			else
				go.x = (tile(go.x, go.y)[1]+1)*8
			end
		--from below	
		elseif (tl or tr) and not (bl or br) then
			if (flr(go.x/8)*8+7 - go.x) > (flr(go.y/8)*8+7 - go.y) then
				go.y = (tile(go.x, go.y)[2]+1)*8
				go.vely = 0
			else
				go.x = (tile(go.x, go.y)[1]+1)*8
			end
		--from side
		else
			go.x = (flr(go.x/8)+1)*8
		end
	
	--left of block
	elseif (tr or br) and not (tl or bl) then
		--from above
		if (bl or br) and not (tl or tr) then
			if (go.x+7 - flr((go.x+7)/8)*8) > (go.y+7 - flr((go.y+7)/8)*8) then			
			 go.y = (tile(go.x, go.y+7)[2]-1)*8
				go.onground = true
				go.vely = 0
			else
			 go.x = (tile(go.x+7, go.y)[1]-1)*8
			end
			
		--from below
		elseif (tl or tr) and not (bl or br) then

			if (go.x+7 - flr((go.x+7)/8)*8) > (flr(go.y/8)*8+7 - go.y) then
				go.y = (tile(go.x+7, go.y)[2]+1)*8
				go.vely = 0
			else
				go.x = (tile(go.x+7, go.y)[1]-1)*8
			end
		else
			go.x = flr(go.x/8)*8
		end
	--middle of block
	else
		--above
		if bl and br then
			go.y = flr(go.y/8)*8
			go.onground = true
			go.vely = 0
		--below
		elseif tl and tr then
			go.y = (flr(go.y/8)+1)*8
			go.vely = 0
		end
	end
	
	-- world borders
	if (go.x < 0) go.x = 0
	if (go.x + 7 > 15*8 + 7) go.x = 15*8
	if (go.y < 0) go.y = 0
	if (go.y + 7 > 15*8 + 7) go.y = 15*8
	
	-- onground or not
	if issolid(go.x,go.y+8) or issolid(go.x+7,go.y+8) then
	 go.onground = true
	else
		go.onground = false
	end
	
	if go.vely > 0 and (isplat(go.x,go.y+8) or isplat(go.x+7,go.y+8)) then
		go.onplat = true
	else
		go.onplat = false
	end
	
end
