pico-8 cartridge // http://www.pico-8.com
version 42
__lua__
function _init()
	levelx,levely = 0,0
	music(0)
	
	local lvldata = lvlinit(levelx,levely)
	spawn = lvldata[1]
	levers = lvldata[2]
	plates = lvldata[3]
	gates = lvldata[4]
	grave = lvldata[5]
	
	players = {plrinit(spawn)}
	playerno = 1
	player = players[playerno]
	player.active = true
end

function _update60()
	if (btn(➡️) or btn(⬅️)) and not player.crouching then 
		if not player.running then
			player.running = true
			player.sprite = 2
		end
			
		if btn(➡️) then
			player.velx = 1
			player.fx = false
		
		else
			player.velx = -1
			player.fx = true
			
		end
		
	else
		player.running = false
	end
	
	if btn(🅾️) then  -- jump
		if player.onplat and player.crouching then
			player.onplat = false
			player.vely = player.gravity
			player.y += 8
		elseif player.onground or player.onplat then
			if player.jmp_cooldown == 0 then
				player.vely = -player.jump_force
				player.onground = false
				player.onplat = false
				player.jmp_cooldown = 30
				sfx(0)
			end
		end
	end
	if btn(⬇️) then  -- crouch
		player.crouching = true
	else
		player.crouching = false
	end
	
	-- switch players / interact
	if btn(❎) and player.cooldown == 0 then -- use/die
		local interacted = false
		-- levers
		for i in all(levers) do
			if (flr(player.x/8) == flr(i.x/8) or
							flr((player.x+7)/8) == flr(i.x/8)) and
						flr(player.y/8) == flr(i.y/8) then
				if not i.active then
					i.active = true
					open_gate(gates, i.id)
				else
					i.active = false
					close_gate(gates, i.id)
				end
				sfx(4)
				interacted = true
			end
		end
		
		-- grave
		if (flr(player.x/8)*8 == grave.x or flr((player.x+7)/8)*8 == grave.x) and 
					flr(player.y/8)*8 == grave.y then	
			levelx += 16
			if levelx > 256 then
				levely += 16
				levelx = 0
			end
			lvlreset(levelx, levely)
			interacted = true
		end
		
		-- plates
		if mget(flr(player.x/8),flr(player.y/8)) == 47 or
					mget(flr((player.x+7)/8),flr(player.y/8)) == 47 then	
			interacted = true
		end				
		
		-- switch
		if not interacted then
			player.active = false		
			playerno += 1
			if (playerno > count(players)) playerno = 1
			player = players[playerno]
			player.active = true
			mset(flr(player.x/8),flr(player.y/8),0)
			player.solid = false
			sfx(2)
		end
		player.cooldown = 10
	end
	
	-- player loop
	for i in all(players) do
		if i.active then
			if player.running then
				player.first_frame = 1
				player.last_frame = 4
				player.ani_speed = 10
			else
				player.velx = 0 
				player.sprite = 1
				player.ani_speed = 0
			end
		else
			if i.vely != 0 then
				i.sprite = 6
			elseif not i.solid then
				if flr(i.x/8 + 1)*8 - i.x > i.x+7 - flr(i.x/8+1)*8 then
					mset(flr(i.x/8),flr(i.y/8),6)
					i.x,i.y = flr(i.x/8)*8,flr(i.y/8)*8
				else
					mset(flr((i.x+7)/8),flr(i.y/8),6)
					i.x,i.y = flr((i.x+7)/8)*8,flr(i.y/8)*8
				end
				i.sprite = 0
				i.solid = true
			end
			i.ani_speed = 0
			i.velx = 0
			if (i.vely < 0) i.vely = 0
			if not i.onground and i.solid then
				mset(flr(i.x/8),flr(i.y/8),0)
				i.solid = false
				i.sprite = 6
			end
		end
		
		if i.vely < 3 and not i.onground then
			i.vely += i.gravity
		end
		
		move(levelx, levely, i)
	end
	
	--pressure plates
	for plate in all(plates) do
		local activated = false
		for i in all(players) do
			if (flr(i.x/8) == flr(plate.x/8) or
							flr((i.x+7)/8) == flr(plate.x/8)) and
							flr(i.y/8) == flr(plate.y/8) then
				activated = true
				break
			end
		end
			
		if activated and not plate.active then
			plate.active = true
			open_gate(gates, plate.id)
			sfx(4)
		elseif not activated and plate.active then
			plate.active = false
			close_gate(gates, plate.id)					
		end		
	end
	
	
	
	--death
	if fget(mget(flr(player.x/8),flr(player.y/8)),3) or
			 fget(mget(flr((player.x+7)/8),flr(player.y/8)),3) then
			 playerno = player:die(playerno, players, spawn)
			 player = players[playerno]
				player.active = true
				player.cooldown = 0
	end
	
	--status
	
	if player.cooldown > 0 then
		player.cooldown -= 1
	end
	
	if player.jmp_cooldown > 0 then
		player.jmp_cooldown -= 1
	end
	
	if player.onground or player.onplat then
		player.vely = 0
		player.y = flr(player.y/8)*8
	end
	
	-- player animation
	if player.velx != 0 then
		if player.stimer >= player.ani_speed then
			player.sprite += 1
			if player.sprite > player.last_frame then
				player.sprite = player.first_frame
			end
			player.stimer = 0
		end
		player.stimer += 1
	else
		player.stimer = 0
		player.sprite = 1
	end
	
	if player.crouching then
		player.sprite = 5
	end
	
	if not (player.onground or player.onplat) then
		player.sprite = 2
	end
end

function _draw()
	camera()
	cls(12)
	circfill(0,0,20,10)
	camera(levelx*8,levely*8)
	map()
	for i in all(players) do
		spr(i.sprite, i.x, i.y,1,1,i.fx,i.fy)
	end
	for i in all(levers) do
		if i.active then 
			spr(14,i.x,i.y)
		else 
			spr(30,i.x,i.y)
		end
	end
	for i in all(plates) do
		if i.active then 
			spr(31,i.x,i.y)
		else 
			spr(15,i.x,i.y)
		end
	end
	spr(45,grave.x,grave.y)
end
-->8
-- player --

function plrinit(spawn)
	local player = {
-- position --
		x = spawn.x, 
		y = spawn.y,
-- flipping --
		fx = false,
		fy = false,
-- sprite animation --
		first_frame = 1,
		last_frame = 1,
		ani_speed = 0,
		sprite = 1,
		stimer = 1,
-- physics --
		velx = 0,
		vely = 0,
		jump_force = 3,
		gravity = 0.2,
-- status --
		active = false,
		solid = false,
		running = false,
		crouching = false,
		onground = true,
		onplat = false,
		cooldown = 0,
		jmp_cooldown = 0,
-- functions --
		die = function(self, playerno, players, spawn)
			self.active = false
			self.velx = 0
			self.vely = 0
			if fget(mget(flr(self.x/8),flr(self.y/8)),3) then
				mset(flr(self.x/8),flr(self.y/8),0)
			end
			if fget(mget(flr((self.x+7)/8),flr(self.y/8)),3) then
				mset(flr((self.x+7)/8),flr(self.y/8),0)
			end
			add(players, plrinit(spawn))		
			playerno = count(players)
			sfx(1)
			return playerno
		end,
	}
	return player
end
-->8
-- collision --
function tile(x, y)
	return {flr(x/8), flr(y/8)}
end

function flagof(x,y)
	return fget(mget(x/8,y/8))
end

function issolid(x,y)
	return fget(mget(x/8,y/8),0)
end

function isplat(x,y)
	return fget(mget(x/8,y/8),1)
end

function move(sx, sy, go) --game object

	go.x += go.velx
	go.y += go.vely
	
	-- flags
	local tlf = flagof(go.x, go.y)
	local trf = flagof(go.x+7, go.y)
	local blf = flagof(go.x, go.y+7)
	local brf = flagof(go.x+7, go.y+7)

	-- solids
	local tl = tlf == 1
	local tr = trf == 1
	local bl = blf == 1
	local br = brf == 1
	
	--right of block
	if (tl or bl) and not (tr or br) then
		--from above
		if (bl or br) and not (tl or tr) then
			if (flr(go.x/8)*8+7 - go.x) > (go.y+7 - flr((go.y+7)/8)*8) then
				go.y = (tile(go.x, go.y+7)[2]-1)*8
				go.onground = true
				go.vely = 0
			else
				go.x = (tile(go.x, go.y)[1]+1)*8
			end
		--from below	
		elseif (tl or tr) and not (bl or br) then
			if (flr(go.x/8)*8+7 - go.x) > (flr(go.y/8)*8+7 - go.y) then
				go.y = (tile(go.x, go.y)[2]+1)*8
				go.vely = 0
			else
				go.x = (tile(go.x, go.y)[1]+1)*8
			end
		--from side
		else
			go.x = (flr(go.x/8)+1)*8
		end
	
	--left of block
	elseif (tr or br) and not (tl or bl) then
		--from above
		if (bl or br) and not (tl or tr) then
			if (go.x+7 - flr((go.x+7)/8)*8) > (go.y+7 - flr((go.y+7)/8)*8) then			
			 go.y = (tile(go.x, go.y+7)[2]-1)*8
				go.onground = true
				go.vely = 0
			else
			 go.x = (tile(go.x+7, go.y)[1]-1)*8
			end
			
		--from below
		elseif (tl or tr) and not (bl or br) then

			if (go.x+7 - flr((go.x+7)/8)*8) > (flr(go.y/8)*8+7 - go.y) then
				go.y = (tile(go.x+7, go.y)[2]+1)*8
				go.vely = 0
			else
				go.x = (tile(go.x+7, go.y)[1]-1)*8
			end
		else
			go.x = flr(go.x/8)*8
		end
	--middle of block
	else
		--above
		if bl and br then
			go.y = flr(go.y/8)*8
			go.onground = true
			go.vely = 0
		--below
		elseif tl and tr then
			go.y = (flr(go.y/8)+1)*8
			go.vely = 0
		end
	end
	
	-- world borders
	if (go.x < sx) go.x = sx
	if (go.x + 7 > (sx+15)*8 + 7) go.x = (sx+15)*8
	if (go.y < sy) go.y = sy
	if (go.y + 7 > (sy+15)*8 + 7) go.y = (sy+15)*8
	
	-- onground or not
	if issolid(go.x,go.y+8) or issolid(go.x+7,go.y+8) then
	 go.onground = true
	else
		go.onground = false
	end
	
	if go.vely > 0 and (isplat(go.x,go.y+8) or isplat(go.x+7,go.y+8)) then
		go.onplat = true
	else
		go.onplat = false
	end
end
-->8
-- level init --

function lvlinit(sx, sy)
	local spawn = {x=0,y=0}
	local plates = {}
	local levers = {}
	local gates = {}
	local grave = {x=0,y=0}
	for i=sx,sx+15 do
		for j=sy,sy+15 do
			if mget(i,j) == 46 then --spawn
				spawn.x,spawn.y=i*8,(j-1)*8
			elseif 32 <= mget(i,j) and mget(i,j) <= 34 then
				add(levers, {x=i*8,y=j*8,active=false,id=34-mget(i,j)})
				mset(i,j,0)
			elseif 48 <= mget(i,j) and mget(i,j) <= 50 then
				add(levers, {x=i*8,y=j*8,active=true,id=34-mget(i,j)}) 
				mset(i,j,0)
			elseif 35 <= mget(i,j) and mget(i,j) <= 37 then
				add(plates, {x=i*8,y=j*8,active=false,id = 37-mget(i,j)})
				mset(i,j,0)
			elseif 51 <= mget(i,j) and mget(i,j) <= 53 then
				add(gates, {x=i*8,y=j*8,open=false,id=53-mget(i,j)})
				mset(i,j,29)
			elseif mget(i,j) == 45 then
				grave.x,grave.y=i*8,j*8
				mset(i,j,0)
			end
		end
	end

	return {spawn,levers,plates,gates,grave}
end

function lvlreset(sx, sy)
	sfx(3)
	local lvldata = lvlinit(sx,sy)
	spawn = lvldata[1]
	levers = lvldata[2]
	plates = lvldata[3]
	gates = lvldata[4]
	grave = lvldata[5]
	
	players = {plrinit(spawn)}
	playerno = 1
	player = players[playerno]
	player.active = true
end

-->8
-- gates --
function open_gate(gates, id)
	for gate in all(gates) do
		if gate.id == id then
			mset(gate.x/8,gate.y/8,47)
			mset(gate.x/8,gate.y/8-1,47)
			if mget(gate.x/8,gate.y/8-2) == 13 then
				mset(gate.x/8,gate.y/8-2,29)
			end 
		end
	end
end

function close_gate(gates, id)
	for gate in all(gates) do
		if gate.id == id then
			if mget(gate.x/8,gate.y/8-2) == 29 then
				mset(gate.x/8,gate.y/8-2,13)
			end
			mset(gate.x/8,gate.y/8-1,13)
			mset(gate.x/8,gate.y/8,29)
		end
	end
end
